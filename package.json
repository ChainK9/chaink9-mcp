    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "honeypot",
    "token-security",
    "rug-pull",
    "bsc",
    "ethereum",
    "base",
    "uniswap",
    "pancakeswap",
    "ai-agents"
  ],
  "homepage": "https://chaink9.com",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainK9/chaink9-mcp.git"
  },
  "scripts": {
